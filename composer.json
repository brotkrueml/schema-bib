{
	"name": "brotkrueml/schema-bib",
	"description": "Schema.org extension for bibliography - Extend the schema extension with bibliographic-related terms",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3 CMS",
		"TYPO3 extension",
		"JSON-LD",
		"Structured data",
		"SEO",
		"schema.org"
	],
	"authors": [
		{
			"name": "Chris Müller",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/brotkrueml/schema-bib/issues",
		"source": "https://github.com/brotkrueml/schema-bib",
		"docs": "https://docs.typo3.org/p/brotkrueml/schema-bib/main/en-us/"
	},
	"require": {
		"php": ">=8.2",
		"brotkrueml/schema": "^4.0",
		"typo3/cms-core": "^13.4 || ^14.3"
	},
	"require-dev": {
		"brotkrueml/coding-standards": "~6.3.1",
		"ergebnis/composer-normalize": "~2.50.0"
	},
	"autoload": {
		"psr-4": {
			"Brotkrueml\\SchemaBib\\": "Classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": false
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"branch-alias": {
			"dev-main": "3.0.x-dev"
		},
		"typo3/cms": {
            "Package": {
                "providesPackages": {}
            },
			"app-dir": ".Build",
			"extension-key": "schema_bib",
            "version": "3.0.0-dev",
			"web-dir": ".Build/web"
		}
	}
}
